-- GUNCELLENMIS LoadMain - Uzak URL + Yerel + Cache fallback
-- ============================================================
local function LoadMain(sg, blur)
    -- Dogrulama zamani tazelenir: main.lua loader'dan geldigini
    -- loader acildiktan sonraki 10 dakika icinde dogrular
    _G.__NOXA_LOADER_TIME = os.time()
    if type(getgenv) == "function" then
        pcall(function() getgenv().__NOXA_LOADER_TIME = os.time() end)
    end
    if sg then sg:Destroy() end
    if blur then blur:Destroy() end
    
    local HAS_FS = type(writefile) == "function" and type(readfile) == "function"
    local source, srcName = nil, nil
    
    -- 1) Once YEREL main.lua: her acilista en guncel surum acilir
    --    (uzak sunucu, yerel dosya varsa hic kullanilmaz)
    if HAS_FS and FsExists(CONFIG.MAIN_LOCAL) then
        local ok, data = pcall(readfile, CONFIG.MAIN_LOCAL)
        if ok and type(data) == "string" and #data > 100 then
            source, srcName = data, "yerel main.lua"
        end
    end

    -- 2) Uzak sunucu (yerel dosya yoksa - diger kullanicilar icin)
    if not source and type(game.HttpGet) == "function" then
        local ok, res = pcall(function() return game:HttpGet(MAIN_URL) end)
        if ok and type(res) == "string" and #res > 100 then
            source, srcName = res, "uzak sunucu"
        end
    end
    
    -- (yerel main.lua okumasi 1. adimda yapildi)
    
    -- 3) Cache dosyasi
    if not source and HAS_FS and FsExists(CONFIG.CACHE_FILE) then
        local ok, data = pcall(readfile, CONFIG.CACHE_FILE)
        if ok then source, srcName = data, "cache dosyasi" end
    end
    
    if not source then return warn("[NOXA] main.lua kaynagi bulunamadi!") end
    print("[NOXA] main kaynagi: " .. tostring(srcName))
    if HAS_FS then pcall(writefile, CONFIG.CACHE_FILE, source) end
    if source:sub(1, 3) == "\239\187\191" then source = source:sub(4) end
    local execFn, execErr = loadstring(source, "@NOXAUi_Main")
    if not execFn then return warn("[NOXA] Syntax Hatasi: " .. tostring(execErr)) end
    local ok, runtimeErr = pcall(execFn)
    if not ok then
        warn("[NOXA] Runtime Hatasi: " .. tostring(runtimeErr))
        -- Yarim kalmis UI varsa temizle, ayni oturumda tekrar denemeye izin ver
        pcall(function()
            if _G.NOXAUi and _G.NOXAUi.Destroy then _G.NOXAUi.Destroy() end
        end)
        _G.NOXA_LOADER_ACTIVE = false
    end
end

