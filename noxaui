            StoreDelete("__noxaprobe.dat")
        else
            warn("[NOXA] DEPOLAMA CALISMIYOR — oturum ve tek kullanimlik key kalici OLMAZ!")
        end
    end)

    local sessData = StoreRead(CONFIG.SESSION_FILE)
    if sessData then
        local okD, savedKey = pcall(decrypt, sessData, SALT)
        if okD and type(savedKey) == "string" and savedKey ~= "" then
            local isValid = ValidateKey(savedKey, true)
            if isValid then
                local exp = GetKeyExpiry(savedKey)
                print("[NOXA] Oturum aktif — key tekrar sorulmayacak. Kalan sure: "
                    .. (exp and FormatRemain(exp) or "bilinmiyor"))
                local blankSg = Instance.new("ScreenGui")
                blankSg.Parent = CoreGui
                LoadMain(blankSg, nil)
                return
            else
                print("[NOXA] Oturum suresi doldu (veya gecersiz) — yeni key isteniyor.")
                StoreDelete(CONFIG.SESSION_FILE)
            end
        else
            warn("[NOXA] Oturum dosyasi bozuk — siliniyor, yeni key istenecek.")
            StoreDelete(CONFIG.SESSION_FILE)
        end
    end

    local sg, main, input, btn, status, blur = CreateUltraLoader()
    local authenticated = false

    btn.MouseButton1Click:Connect(function()
        if authenticated then return end
        status.Text = "Dogrulaniyor..."
        status.TextColor3 = Color3.fromRGB(255, 200, 100)
        btn.Text = "LUTFEN BEKLEYIN..."
        
        task.wait(1)

        local cleanKey = string.match(input.Text or "", "^%s*(.-)%s*$") or input.Text
        input.Text = cleanKey
        local isValid, msg = ValidateKey(cleanKey, false)
        if isValid then
            authenticated = true
            MarkKeyAsUsed(cleanKey)
            local sessOk, sessPath = StoreWrite(CONFIG.SESSION_FILE, encrypt(cleanKey, SALT))
            if sessOk then
                print("[NOXA] Oturum kaydedildi: " .. tostring(sessPath))
            else
                warn("[NOXA] OTURUM KAYDEDILEMEDI — sonraki acilista key tekrar sorulacak.")
            end
            SendInfoWebhook("Key girisi onaylandi", 3066993, cleanKey)

            local exp = GetKeyExpiry(cleanKey)
            status.Text = "Lisans Onaylandi! Kalan: " .. (exp and FormatRemain(exp) or "?")
            status.TextColor3 = Color3.fromRGB(100, 255, 100)
            btn.Text = "YUKLENIYOR..."
            btn.BackgroundColor3 = Color3.fromRGB(100, 255, 100)

            TweenService:Create(blur, TweenInfo.new(0.5), { Size = 0 }):Play()
            task.wait(0.6)
            LoadMain(sg, blur)
        else
            status.Text = tostring(msg)
            status.TextColor3 = Color3.fromRGB(255, 100, 100)
            btn.Text = "DOGRULA VE BASLAT"
            
            local origPos = main.Position
            TweenService:Create(main, TweenInfo.new(0.05), { Position = origPos + UDim2.new(0, 10, 0, 0) }):Play()
            task.wait(0.05)
            TweenService:Create(main, TweenInfo.new(0.05), { Position = origPos - UDim2.new(0, 10, 0, 0) }):Play()
            task.wait(0.05)
            TweenService:Create(main, TweenInfo.new(0.05), { Position = origPos }):Play()
        end
    end)

    input.FocusLost:Connect(function(enter)
        if enter and not authenticated then btn:Activate() end
    end)
end

StartSystem()
