    local function PredictPosition(char, part)
        local pos = part.Position
        if not CFG.AimPrediction then return pos end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return pos end
        local v = hrp.AssemblyLinearVelocity or hrp.Velocity
        local t = CFG.AimPredictionVal
        pos = pos + v * t
        if CFG.AimGravityComp > 0 then
            pos = pos + Vector3.new(0, 0.5 * Workspace.Gravity * t * t * CFG.AimGravityComp, 0)
        end
        return pos
    end

    local function ThreatScore(p, myPos)
        local score = 0
        local char = p.Character
        if not char then return 0 end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return 0 end
        local delta = myPos - hrp.Position
        if delta.Magnitude < 0.001 then return 0 end
        local dirToMe = delta.Unit
        local look = hrp.CFrame.LookVector
        local dot = look:Dot(dirToMe)
        if dot > 0.5 then score = score + 100 end
        local dmg = DamageLog[p.UserId]
        if dmg and (now() - dmg.t) < CFG.AimThreatWindow then
            score = score + dmg.amount * 10
        end
        return score
    end

    local function GetTarget()
        local char = LocalPlayer.Character
        local myRoot = char and char:FindFirstChild("HumanoidRootPart")
