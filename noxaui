        if not kbConn then
            kbConn = UIS.InputBegan:Connect(function(i, gpe)
                if not open then return end
                if i.UserInputType ~= Enum.UserInputType.Keyboard then return end
                if i.KeyCode == Enum.KeyCode.Escape then
                    PL.Close()
                elseif i.KeyCode == Enum.KeyCode.Down then
                    cursor = math.min(cursor + 1, math.max(#results, 1))
                    Render()
                elseif i.KeyCode == Enum.KeyCode.Up then
                    cursor = math.max(cursor - 1, 1)
                    Render()
                elseif i.KeyCode == Enum.KeyCode.Return or i.KeyCode == Enum.KeyCode.KeypadEnter then
                    Jump(results[cursor])
                end
            end)
        end
        DBG("palette open")
    end

