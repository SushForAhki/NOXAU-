        if not CFG.ESPItem then
            for _, sh in pairs(itemShapes) do HideShape(sh) end
        else
            local col = ColFromT(CFG.ESPItemColor)
            for it, sh in pairs(itemShapes) do
                local pos = it.Parent and GetItemPos(it)
                if pos then
                    DrawBox(sh, pos, it.Name, col, myRoot, CFG.ESPMaxItemDist)
                else
                    HideShape(sh)
                end
            end
        end
    end

    task.spawn(function()
        local nextSync = 0
        while gui.Parent do
            local t = now()
            -- senkron cok ucuz (harita taramasi artik yok), 4Hz
            if t >= nextSync then
                nextSync = t + 0.25
                pcall(SyncRegistry)
            end
            if t >= nextRender then
                nextRender = t + RENDER_EVERY
                pcall(RenderAll)
            end
            task.wait(0.05)
        end
    end)

    function NIE.Cleanup()
        for m, sh in pairs(npcShapes) do DropShape(sh) npcShapes[m] = nil end
        for it, sh in pairs(itemShapes) do DropShape(sh) itemShapes[it] = nil end
    end

    _G.NOXAUi.NPCItemESP = NIE
    DBG("npc/item esp ready")
end)()

