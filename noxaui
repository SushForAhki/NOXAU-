        l1.To = Vector2.new(x2, y1)
        l2.From = Vector2.new(x2, y1)
        l2.To = Vector2.new(x2, y2)
        l3.From = Vector2.new(x2, y2)
        l3.To = Vector2.new(x1, y2)
