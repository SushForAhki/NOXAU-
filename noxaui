    acc.BackgroundColor3 = C.Accent
    acc.BorderSizePixel = 0
    acc.BackgroundTransparency = 1
    acc.Parent = btn
    Instance.new("UICorner", acc).CornerRadius = UDim.new(1, 0)

    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1, 0, 1, 0)
