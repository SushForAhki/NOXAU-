            if cur.Parent == PageHolder then return cur end
            cur = cur.Parent
        end
        return nil
    end

    local function findTabName(page)
        for name, t in pairs(Tabs) do
            if t.page == page then return name end
        end
        return nil
    end

    local function ResolveTargets()
        local list = {}
        for _, item in ipairs(PaletteTargets) do
            if item.elem and item.elem.Parent then
                local page = findPage(item.elem)
                list[#list + 1] = {
                    kind = item.kind,
                    text = item.text,
                    display = item.display or item.text,
                    elem = item.elem,
                    page = page,
                    tabName = page and findTabName(page) or nil,
                }
            end
        end
        for name, t in pairs(Tabs) do
            list[#list + 1] = {
                kind = "tab",
                text = string.lower(name),
                display = name,
                elem = t.btn,
                page = t.page,
                tabName = name,
            }
        end
        return list
    end

    local function ComputeResults(q)
        local all = ResolveTargets()
        local list = {}
        if q == "" then
            local recent = CFG.PaletteRecent or {}
            for _, r in ipairs(recent) do
                for _, e in ipairs(all) do
                    if e.text == r then
                        list[#list + 1] = e
                        break
                    end
                end
            end
            for _, e in ipairs(all) do
                if e.kind == "tab" then list[#list + 1] = e end
            end
        else
            for _, e in ipairs(all) do
                local idx = e.text:find(q, 1, true)
                if idx then
                    local score = (idx == 1 and 0 or 2)
                        + (e.kind == "tab" and 0 or (e.kind == "section" and 0.5 or 1))
                    e._score = score
                    list[#list + 1] = e
                end
            end
            table.sort(list, function(a, b)
                if a._score ~= b._score then return a._score < b._score end
                return a.text < b.text
            end)
        end
        while #list > 40 do table.remove(list) end
        return list
    end

    local function Remember(e)
        local rec = CFG.PaletteRecent or {}
        CFG.PaletteRecent = rec
        for i = #rec, 1, -1 do
            if rec[i] == e.text then table.remove(rec, i) end
        end
        table.insert(rec, 1, e.text)
        while #rec > 8 do table.remove(rec) end
    end

