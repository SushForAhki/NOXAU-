local function XorAdd(text, key)
    local out = {}
    for i = 1, #text do
        local b = string.byte(text, i)
        local k = string.byte(key, (i - 1) % #key + 1)
        out[#out + 1] = string.char((b + k) % 256)
    end
    return table.concat(out)
end

local function XorSub(text, key)
    local out = {}
    for i = 1, #text do
        local b = string.byte(text, i)
        local k = string.byte(key, (i - 1) % #key + 1)
        out[#out + 1] = string.char((b - k) % 256)
    end
    return table.concat(out)
end

-- ============================================================
-- BASE64 — saf Lua yedekli. Bazi executorlarda (Xeno vb.)
-- HttpService:Base64Encode/Decode YOK → Save/Load sessizce
-- patliyordu (config hic kaydedilmiyordu). Varsa executor
-- metodu, yoksa saf Lua ile ayni RFC4648 cikti uretilir.
-- ============================================================
local B64C = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local B64LOOKUP = {}
for i = 1, #B64C do
    B64LOOKUP[string.sub(B64C, i, i)] = i - 1
end
local HAS_B64 = pcall(function() return HttpSvc:Base64Encode("x") end)

local function B64Encode(data)
    if HAS_B64 then
        local ok, res = pcall(function() return HttpSvc:Base64Encode(data) end)
        if ok and type(res) == "string" then return res end
    end
    local out = {}
    local n = #data
    local i = 1
    while i <= n do
        local a = string.byte(data, i)
        local b = string.byte(data, i + 1)
        local c = string.byte(data, i + 2)
        local n1 = math.floor(a / 4)
        local n2 = (a % 4) * 16 + math.floor((b or 0) / 16)
        out[#out + 1] = string.sub(B64C, n1 + 1, n1 + 1)
        out[#out + 1] = string.sub(B64C, n2 + 1, n2 + 1)
        if b then
            local n3 = (b % 16) * 4 + math.floor((c or 0) / 64)
            out[#out + 1] = string.sub(B64C, n3 + 1, n3 + 1)
        else
            out[#out + 1] = "="
        end
        if c then
            local n4 = c % 64
            out[#out + 1] = string.sub(B64C, n4 + 1, n4 + 1)
        else
            out[#out + 1] = "="
        end
        i = i + 3
    end
    return table.concat(out)
end

local function B64Decode(data)
    if HAS_B64 then
        local ok, res = pcall(function() return HttpSvc:Base64Decode(data) end)
        if ok and type(res) == "string" then return res end
    end
    local cleaned = string.gsub(data, "[^A-Za-z0-9+/=]", "")
    cleaned = string.gsub(cleaned, "=", "")
    local out = {}
    local buf, bits = 0, 0
    for i = 1, #cleaned do
        local v = B64LOOKUP[string.sub(cleaned, i, i)]
        if v then
            buf = buf * 64 + v
            bits = bits + 6
            if bits >= 8 then
                bits = bits - 8
                out[#out + 1] = string.char(math.floor(buf / (2 ^ bits)) % 256)
                buf = buf % (2 ^ bits)
            end
        end
    end
    return table.concat(out)
end

local function DeepCopy(t)
    local c = {}
    for k, v in pairs(t) do
        if type(v) == "table" then c[k] = DeepCopy(v) else c[k] = v end
    end
    return c
end

