        if CFG.ESPWeapon then
            if doText then
                local tool = char:FindFirstChildOfClass("Tool")
                data.weaponLbl.Text = tool and tool.Name or ""
            end
            data.weaponLbl.Visible = true
        else
            data.weaponLbl.Visible = false
        end
    end
