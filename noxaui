    local function JoinServerId(id, mode)
        if type(id) ~= "string" or id == "" or AUT.busy then return false end
        if AUT.blacklist[id] then return false end
        AUT.busy = true
        AUT.pendingMode = mode or "Rastgele"
        pcall(Save)
        local ok = pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, id, LocalPlayer)
        end)
        if not ok then
            AUT.blacklist[id] = os.time()
            AUT.busy = false
            return false
        end
        task.delay(8, function() AUT.busy = false end)
        return true
    end

    local function HopByMode(mode)
        AUT.lastFetch = os.clock()
        local list = FetchServers(mode == "En Çok Oyuncu" and "Desc" or "Asc", 100)
        if not list or #list == 0 then
            AddNotif("Otomasyonlar", "sunucu listesi alınamadı (API)", 5)
            return false
        end
        local cands = {}
        for _, s in ipairs(list) do
            local pc = tonumber(s.playerCount or s.playing) or 0
            local mx = tonumber(s.maxPlayers or s.capacity) or 100
            local sid = s.id
            if type(sid) == "string" and sid ~= game.JobId
                and pc < mx and not AUT.blacklist[sid] then
                table.insert(cands, { id = sid, pc = pc })
            end
        end
        if #cands == 0 then
            AddNotif("Otomasyonlar", "uygun sunucu yok (hepsi kısıtlı/blacklist)", 5)
            return false
        end
        local pick
        if mode == "Rastgele" then
            pick = cands[math.random(#cands)]
        elseif mode == "En Çok Oyuncu" then
            table.sort(cands, function(a, b) return a.pc > b.pc end)
            pick = cands[1]
        else
            table.sort(cands, function(a, b) return a.pc < b.pc end)
            pick = cands[1]
        end
        AddNotif("Otomasyonlar", mode .. " → " .. pick.pc .. " kişilik sunucuya atlanıyor", 5)
        local ok = JoinServerId(pick.id, mode)
        if not ok then
            AUT.blacklist[pick.id] = os.time()
            task.delay(1, function() if gui.Parent and not AUT.busy then HopByMode(mode) end end)
        end
        return ok
    end

    local function ManualHop(mode)
        if AUT.busy then
            AddNotif("Otomasyonlar", "zaten ışınlanıyor", 4)
            return
        end
        if os.clock() - AUT.lastFetch < 2 then
            AddNotif("Otomasyonlar", "çok hızlı — 2 sn bekle", 4)
            return
        end
        HopByMode(mode)
    end

