local function lua_hash(s)
    local h = 0
    for i = 1, #s do h = (h * 31 + string.byte(s, i)) % 100000000 end
    return string.format("%08d", h)
end

local function from_base36(s)
    local chars = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    local num = 0
    for i = 1, #s do
        local char = string.sub(s, i, i)
        local val = string.find(chars, char, 1, true)
        if val then num = num * 36 + (val - 1) end
    end
    return num
end

-- ============================================================
-- BASE64 — saf Lua yedekli. Bazi executorlarda (Xeno vb.)
-- HttpService:Base64Encode/Decode YOK → key kaydi/oturum
-- sessizce patliyordu. Varsa executor metodu, yoksa saf Lua
-- ile ayni RFC4648 cikti uretilir (eski dosyalarla uyumlu).
-- ============================================================
local B64C = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local B64LOOKUP = {}
for i = 1, #B64C do
    B64LOOKUP[string.sub(B64C, i, i)] = i - 1
end
local HAS_B64 = pcall(function() return HttpService:Base64Encode("x") end)

local function B64Encode(data)
    if HAS_B64 then
        local ok, res = pcall(function() return HttpService:Base64Encode(data) end)
        if ok and type(res) == "string" then return res end
    end
    local out = {}
    local n = #data
    local i = 1
    while i <= n do
        local a = string.byte(data, i)
        local b = string.byte(data, i + 1)
        local c = string.byte(data, i + 2)
        local n1 = math.floor(a / 4)
        local n2 = (a % 4) * 16 + math.floor((b or 0) / 16)
        out[#out + 1] = string.sub(B64C, n1 + 1, n1 + 1)
        out[#out + 1] = string.sub(B64C, n2 + 1, n2 + 1)
        if b then
            local n3 = (b % 16) * 4 + math.floor((c or 0) / 64)
            out[#out + 1] = string.sub(B64C, n3 + 1, n3 + 1)
        else
            out[#out + 1] = "="
        end
        if c then
            local n4 = c % 64
            out[#out + 1] = string.sub(B64C, n4 + 1, n4 + 1)
        else
            out[#out + 1] = "="
        end
        i = i + 3
    end
    return table.concat(out)
end

local function B64Decode(data)
    if HAS_B64 then
        local ok, res = pcall(function() return HttpService:Base64Decode(data) end)
        if ok and type(res) == "string" then return res end
    end
    local cleaned = string.gsub(data, "[^A-Za-z0-9+/=]", "")
    cleaned = string.gsub(cleaned, "=", "")
    local out = {}
    local buf, bits = 0, 0
    for i = 1, #cleaned do
        local v = B64LOOKUP[string.sub(cleaned, i, i)]
        if v then
            buf = buf * 64 + v
            bits = bits + 6
            if bits >= 8 then
                bits = bits - 8
                out[#out + 1] = string.char(math.floor(buf / (2 ^ bits)) % 256)
                buf = buf % (2 ^ bits)
            end
        end
    end
    return table.concat(out)
end

local function encrypt(text, key)
    local res = ""
    for i = 1, #text do
        local char = string.byte(text, i)
        local k = string.byte(key, (i - 1) % #key + 1)
        res = res .. string.char((char + k) % 256)
    end
    return B64Encode(res)
end

local function decrypt(text, key)
    local decoded = B64Decode(text)
    local res = ""
    for i = 1, #decoded do
        local char = string.byte(decoded, i)
        local k = string.byte(key, (i - 1) % #key + 1)
        res = res .. string.char((char - k) % 256)
    end
    return res
end

local function IsKeyUsed(key)
    local data = StoreRead(CONFIG.USED_KEYS_FILE)
    if not data then return false end
    local ok, decrypted = pcall(decrypt, data, SALT)
    if not ok or type(decrypted) ~= "string" then return false end
    local hashedKey = lua_hash(key)
    if string.find(decrypted, hashedKey, 1, true) then return true end
    return false
end

local function MarkKeyAsUsed(key)
    local hashedKey = lua_hash(key)
    local existing = ""
    local data = StoreRead(CONFIG.USED_KEYS_FILE)
    if data then
        local ok, dec = pcall(decrypt, data, SALT)
        if ok and type(dec) == "string" then existing = dec end
    end
    existing = existing .. "|" .. hashedKey
    local okStore, storePath = StoreWrite(CONFIG.USED_KEYS_FILE, encrypt(existing, SALT))
    if not okStore then
        warn("[NOXA] TEK KULLANIMLIK KAYDI YAZILAMADI — bu key tekrar girilebilir!")
    else
        print("[NOXA] Kullanilan key kaydedildi: " .. tostring(storePath))
    end
    return okStore
end

