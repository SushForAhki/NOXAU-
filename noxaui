local function ShowTooltip(text)
    if not text or text == "" then return end
    tipLbl.Text = text
    TooltipFrame.Visible = true
    local m = UIS:GetMouseLocation()
    TooltipFrame.Position = UDim2.fromOffset(m.X + 14, m.Y + 14)
end
local function HideTooltip() TooltipFrame.Visible = false end
local function AttachTooltip(elem, key)
    local text = Tooltips[key or ""]
    if not text then return end
    elem.MouseEnter:Connect(function() ShowTooltip(text) end)
    elem.MouseLeave:Connect(function() HideTooltip() end)
end
_G.NOXAUi.ShowTooltip = ShowTooltip
_G.NOXAUi.HideTooltip = HideTooltip
_G.NOXAUi.AttachTooltip = AttachTooltip
_G.NOXAUi.Tooltips = Tooltips

