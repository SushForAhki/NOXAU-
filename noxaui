    local function DrawBox(sh, pos, label, color, myRoot, maxDist)
        local dist = myRoot and (myRoot.Position - pos).Magnitude or 0
        if maxDist > 0 and dist > maxDist then HideShape(sh) return end
        local sp, on = Camera:WorldToViewportPoint(pos)
