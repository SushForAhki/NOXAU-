        pS.Color = C.Border
        pS.Thickness = 1
        pS.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        pS.Parent = popup

        local function sync()
            swatch.BackgroundColor3 = Color3.fromRGB(cur[1], cur[2], cur[3])
