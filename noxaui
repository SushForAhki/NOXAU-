local function DHidePlayer(data)
    if not data then return end
    if data.box then for _, l in ipairs(data.box) do if l then l.Visible = false end end end
    if data.fill then data.fill.Visible = false end
    if data.skeleton then for _, l in ipairs(data.skeleton) do if l then l.Visible = false end end end
    for _, k in ipairs({ "hpBg", "hpFill", "tracer", "dist", "hpText", "headDot", "flags" }) do
        if data[k] then data[k].Visible = false end
    end
    if data.nameGui then data.nameGui.Enabled = false end
    if data.highlight then data.highlight.Enabled = false end
end

local function DRemovePlayer(p)
    local data = ESP.Pool[p]
    if not data then return end
    if data.nameGui then pcall(function() data.nameGui:Destroy() end) end
    if data.box then for _, l in ipairs(data.box) do DrawingRemove(l) end end
    DrawingRemove(data.fill)
    if data.skeleton then for _, l in ipairs(data.skeleton) do DrawingRemove(l) end end
    for _, k in ipairs({ "hpBg", "hpFill", "tracer", "dist", "hpText", "headDot", "flags" }) do DrawingRemove(data[k]) end
    if data.highlight then pcall(function() data.highlight:Destroy() end) end
    ESP.Pool[p] = nil
    DBG("esp pool: removed", p.Name)
end

local BONES_R15 = {
    { "Head", "UpperTorso" }, { "UpperTorso", "LowerTorso" },
    { "UpperTorso", "LeftUpperArm" }, { "LeftUpperArm", "LeftLowerArm" }, { "LeftLowerArm", "LeftHand" },
    { "UpperTorso", "RightUpperArm" }, { "RightUpperArm", "RightLowerArm" }, { "RightLowerArm", "RightHand" },
    { "LowerTorso", "LeftUpperLeg" }, { "LeftUpperLeg", "LeftLowerLeg" }, { "LeftLowerLeg", "LeftFoot" },
    { "LowerTorso", "RightUpperLeg" }, { "RightUpperLeg", "RightLowerLeg" }, { "RightLowerLeg", "RightFoot" },
    { "Head", "HumanoidRootPart" },
}

local BONES_R6 = {
    { "Head", "Torso" }, { "Torso", "Left Arm" }, { "Torso", "Right Arm" },
    { "Torso", "Left Leg" }, { "Torso", "Right Leg" },
}

local function BuildBoneCache(char)
    local r15 = char:FindFirstChild("UpperTorso") ~= nil
    local bones = r15 and BONES_R15 or BONES_R6
    local cache = {}
    for _, pair in ipairs(bones) do
        local a = char:FindFirstChild(pair[1])
        local b = char:FindFirstChild(pair[2])
        if a and b then table.insert(cache, { a, b }) end
    end
    return cache
end

local VisCache = {}
local function ESPVisibleCheck(p, char, hrp, myRoot)
    if not myRoot then return true end
    local cached = VisCache[p]
    local t = now()
    if cached and (t - cached.t) < 0.15 then return cached.v end
    local head = char:FindFirstChild("Head") or hrp
    local visible = true
    local dir = head.Position - myRoot.Position
    if dir.Magnitude > 0.01 then
        local hit = Ray(myRoot.Position, dir.Unit, dir.Magnitude, { char })
        if hit and not hit.Instance:IsDescendantOf(char) then visible = false end
    end
    VisCache[p] = { t = t, v = visible }
    return visible
end

Players.PlayerRemoving:Connect(function(p) VisCache[p] = nil end)

local function UpdatePlayerESP(data, myRoot)
    local p = data.player
    local char = p.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    if not char or not hrp or not hum or hum.Health <= 0 then
        if CFG.ESPCorpse and char and hrp
            and not (CFG.ESPTeamCheck and p.Team == LocalPlayer.Team) then
            local spc, onc = Camera:WorldToViewportPoint(hrp.Position)
            local distc = myRoot and (myRoot.Position - hrp.Position).Magnitude or 0
            if onc and spc.Z > 0 and (CFG.ESPMaxDist <= 0 or distc <= CFG.ESPMaxDist) then
                local topc = Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 3, 0))
                local botc = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                local hc = math.abs(topc.Y - botc.Y)
                local wc = hc * 0.5
                local x1c, x2c = spc.X - wc / 2, spc.X + wc / 2
                local y1c, y2c = spc.Y - hc / 2, spc.Y + hc / 2
                local grey = Color3.fromRGB(120, 120, 130)
                if data.box then
                    local b = data.box
                    local function setl(line, fx, fy, tx2, ty)
                        line.From = Vector2.new(fx, fy)
                        line.To = Vector2.new(tx2, ty)
                        line.Color = grey
                        line.Thickness = 1
                        line.Transparency = 0.5
                        line.Visible = true
                    end
                    setl(b[1], x1c, y1c, x2c, y1c)
                    setl(b[2], x2c, y1c, x2c, y2c)
                    setl(b[3], x2c, y2c, x1c, y2c)
                    setl(b[4], x1c, y2c, x1c, y1c)
                    for i = 5, 8 do b[i].Visible = false end
                end
                if data.fill then data.fill.Visible = false end
                if data.skeleton then
                    for _, l in ipairs(data.skeleton) do l.Visible = false end
                end
                if data.hpBg then data.hpBg.Visible = false end
                if data.hpFill then data.hpFill.Visible = false end
                if data.hpText then data.hpText.Visible = false end
                if data.tracer then data.tracer.Visible = false end
                if data.dist then data.dist.Visible = false end
                if data.headDot then data.headDot.Visible = false end
                if data.flags then data.flags.Visible = false end
                if data.highlight then data.highlight.Enabled = false end
                if data.nameLbl then
                    data.nameLbl.Text = CFG.StreamerMode
                        and ("OYUNCU-" .. tostring(data.anonId or 0)) or p.Name
                    data.nameLbl.TextColor3 = grey
                end
                if data.nameGui then data.nameGui.Enabled = CFG.ESPName end
                return
            end
        end
        DHidePlayer(data)
        return
    end
    if CFG.ESPTeamCheck and p.Team == LocalPlayer.Team then
        DHidePlayer(data)
        return
    end
    if CFG.ESPVisibleOnly and not ESPVisibleCheck(p, char, hrp, myRoot) then
        DHidePlayer(data)
        return
    end

    local sp, onScreen = Camera:WorldToViewportPoint(hrp.Position)
    local dist = myRoot and (myRoot.Position - hrp.Position).Magnitude or 0

    if not onScreen or sp.Z <= 0 or (CFG.ESPMaxDist > 0 and dist > CFG.ESPMaxDist) then
        DHidePlayer(data)
        return
    end

    local top = Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 3, 0))
    local bot = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
    local h = math.abs(top.Y - bot.Y)
    local w = h * 0.5
    local x1 = sp.X - w / 2
    local x2 = sp.X + w / 2
    local y1 = sp.Y - h / 2
    local y2 = sp.Y + h / 2
    local cl = math.min(w, h) * math.clamp(CFG.ESPBoxCorner or 0.25, 0.05, 0.6)

    local alpha = 1
    if CFG.ESPDistanceAlpha and CFG.ESPMaxDist > 0 then
        alpha = math.clamp(1 - (dist / CFG.ESPMaxDist) * 0.7, 0.3, 1)
    end

    local col = ColFromT(CFG.ESPColor)
    local nameCol = ColFromT(CFG.ESPNameColor)
    local tracerCol = ColFromT(CFG.ESPTracerColor)
    local chamsCol = ColFromT(CFG.ESPChamsColor)

    -- PERFORMANS: metin guncelleme (dist/can/flag/silah) 0.15sn'de bir,
    -- kutu/cizim konumlari her tikta tazelenir (akis bozulmaz)
    local tnow = now()
    local doText = (data._tTxt or 0) <= tnow
    if doText then data._tTxt = tnow + 0.15 end

    if data.box and CFG.ESPBox then
        if CFG.ESPBoxStyle == "köşe" then
            if data.fill then data.fill.Visible = false end
            local function sl(line, from, to)
                line.From = from
                line.To = to
                line.Color = col
                line.Thickness = CFG.ESPThickness
                line.Transparency = 1 - alpha
                line.Visible = true
            end
            sl(data.box[1], Vector2.new(x1, y1), Vector2.new(x1 + cl, y1))
            sl(data.box[2], Vector2.new(x1, y1), Vector2.new(x1, y1 + cl))
            sl(data.box[3], Vector2.new(x2, y1), Vector2.new(x2 - cl, y1))
            sl(data.box[4], Vector2.new(x2, y1), Vector2.new(x2, y1 + cl))
            sl(data.box[5], Vector2.new(x1, y2), Vector2.new(x1 + cl, y2))
            sl(data.box[6], Vector2.new(x1, y2), Vector2.new(x1, y2 - cl))
            sl(data.box[7], Vector2.new(x2, y2), Vector2.new(x2 - cl, y2))
            sl(data.box[8], Vector2.new(x2, y2), Vector2.new(x2, y2 - cl))
        else
            for _, l in ipairs(data.box) do l.Visible = false end
            if data.fill then
                data.fill.Size = Vector2.new(w, h)
                data.fill.Position = Vector2.new(x1, y1)
                data.fill.Color = col
                data.fill.Transparency = 0.85
                data.fill.Visible = true
            end
        end
    else
        if data.box then for _, l in ipairs(data.box) do l.Visible = false end end
        if data.fill then data.fill.Visible = false end
    end

    if data.skeleton and CFG.ESPSkeleton then
        if not data.boneCache or data.boneCache.char ~= char then
            data.boneCache = { char = char, bones = BuildBoneCache(char) }
        end
        for i = 1, 15 do
            local line = data.skeleton[i]
            local pair = data.boneCache.bones[i]
            if line and pair then
                local av, aon = Camera:WorldToViewportPoint(pair[1].Position)
                local bv, bon = Camera:WorldToViewportPoint(pair[2].Position)
                if aon and bon and av.Z > 0 and bv.Z > 0 then
                    line.From = Vector2.new(av.X, av.Y)
                    line.To = Vector2.new(bv.X, bv.Y)
                    line.Color = col
                    line.Thickness = 2
                    line.Transparency = 1 - alpha
                    line.Visible = true
                else
                    line.Visible = false
                end
            elseif line then
                line.Visible = false
            end
        end
    elseif data.skeleton then
        for _, l in ipairs(data.skeleton) do l.Visible = false end
    end

    if CFG.ESPChams then
        if not data.highlight or not data.highlight.Parent then
            local hl = Instance.new("Highlight")
            hl.Name = "NOXAUi_Chams_" .. p.Name
            hl.Adornee = char
            hl.FillColor = chamsCol
            hl.FillTransparency = 0.5
            hl.OutlineColor = chamsCol
            hl.OutlineTransparency = 0
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = gui
            data.highlight = hl
        else
            data.highlight.Enabled = true
            data.highlight.FillColor = chamsCol
            data.highlight.OutlineColor = chamsCol
        end
    elseif data.highlight then
        data.highlight.Enabled = false
    end

    if data.hpBg and data.hpFill and CFG.ESPHealth then
        local ratio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
        local hpCol = ratio > 0.6 and C.Success
            or (ratio > 0.3 and Color3.fromRGB(230, 190, 40) or C.Danger)
        if CFG.ESPHealthStyle == "Sayısal" then
            data.hpBg.Visible = false
            data.hpFill.Visible = false
        elseif CFG.ESPHealthStyle == "Yatay" then
            local barY = y2 + 10
            data.hpBg.From = Vector2.new(x1, barY)
            data.hpBg.To = Vector2.new(x2, barY)
            data.hpBg.Visible = true
            data.hpFill.From = Vector2.new(x1, barY)
            data.hpFill.To = Vector2.new(x1 + (w * ratio), barY)
            data.hpFill.Color = hpCol
            data.hpFill.Visible = true
        else
            local hpX = x1 - 6
            data.hpBg.From = Vector2.new(hpX, y1)
            data.hpBg.To = Vector2.new(hpX, y2)
            data.hpBg.Visible = true
            local fillY = y2 - (h * ratio)
            data.hpFill.From = Vector2.new(hpX, fillY)
            data.hpFill.To = Vector2.new(hpX, y2)
            data.hpFill.Color = hpCol
            data.hpFill.Visible = true
        end
    elseif data.hpBg then
        data.hpBg.Visible = false
        if data.hpFill then data.hpFill.Visible = false end
    end

    if data.tracer and CFG.ESPTracer then
        data.tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
        data.tracer.To = Vector2.new(sp.X, sp.Y)
        data.tracer.Color = tracerCol
        data.tracer.Transparency = 1 - alpha
        data.tracer.Visible = true
    elseif data.tracer then
        data.tracer.Visible = false
    end

    if data.dist and CFG.ESPDist then
        if doText then data.dist.Text = math.floor(dist) .. "m" end
        data.dist.Position = Vector2.new(sp.X, y2 + 6)
        data.dist.Color = C.Text
        data.dist.Transparency = 1 - alpha
        data.dist.Visible = true
    elseif data.dist then
        data.dist.Visible = false
    end

    if data.hpText and hum and CFG.ESPHealthText and CFG.ESPHealth then
        local ratio = hum.Health / math.max(hum.MaxHealth, 1)
        local hpColor = ratio > 0.6 and C.Success or (ratio > 0.3 and Color3.fromRGB(230, 200, 40) or C.Danger)
        if doText then data.hpText.Text = math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth) end
        data.hpText.Color = hpColor
        data.hpText.Position = Vector2.new(x1 - 30, y2 + 4)
        data.hpText.Visible = true
    elseif data.hpText then
        data.hpText.Visible = false
    end

    if data.headDot then
        if CFG.ESPHeadDot then
            local head = char:FindFirstChild("Head")
            local hp, hon = head and Camera:WorldToViewportPoint(head.Position)
            if hon and hp.Z > 0 then
                data.headDot.Radius = math.max(CFG.ESPHeadDotSize, 1)
                data.headDot.Position = Vector2.new(hp.X, hp.Y)
                data.headDot.Color = ColFromT(CFG.ESPHeadDotColor)
                data.headDot.Transparency = 1 - alpha
                data.headDot.Visible = true
            else
