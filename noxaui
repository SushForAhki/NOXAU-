                    local hum = c:FindFirstChildOfClass("Humanoid")
                    local hrp = c:FindFirstChild("HumanoidRootPart")
                    if hum and hrp and hum.Health > 0 then
                        local part
                        if CFG.AimTargetPart == "Kafa" then
                            part = c:FindFirstChild("Head")
                            if not part and CFG.AimHeadFallback then
                                part = c:FindFirstChild("UpperTorso")
                                    or c:FindFirstChild("Torso")
                                    or hrp
                            end
                        else
                            part = c:FindFirstChild("UpperTorso")
                                or c:FindFirstChild("Torso")
                                or c:FindFirstChild("LowerTorso")
                                or hrp
                        end
                        if part and (CFG.AimMaxRange <= 0 or (hrp.Position - myRoot.Position).Magnitude <= CFG.AimMaxRange) then
                            local aimPos = PredictPosition(c, part)
                            local sp, onScreen = Camera:WorldToViewportPoint(aimPos)
                            if onScreen and sp.Z > 0 then
                                local sd = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                                if sd <= fov then
                                    local visible = true
                                    if CFG.AimWallCheck then
                                        if CFG.AimVisCache then
                                            local cch = VisCacheAim[p]
                                            local tt = now()
                                            if cch and (tt - cch.t) * 1000 < CFG.AimVisCacheMs then
                                                visible = cch.v
                                            else
                                                local dir = aimPos - myRoot.Position
                                                if dir.Magnitude > 0.01 then
                                                    local hit = Ray(myRoot.Position, dir.Unit, dir.Magnitude, { char })
                                                    if hit and not hit.Instance:IsDescendantOf(c) then visible = false end
                                                end
                                                VisCacheAim[p] = { t = tt, v = visible }
                                            end
                                        else
                                            local dir = aimPos - myRoot.Position
                                            if dir.Magnitude > 0.01 then
                                                local hit = Ray(myRoot.Position, dir.Unit, dir.Magnitude, { char })
                                                if hit and not hit.Instance:IsDescendantOf(c) then visible = false end
                                            end
                                        end
                                    end
                                    if visible then
                                        table.insert(candidates, {
                                            part = part,
                                            aimPos = aimPos,
                                            hum = hum,
                                            hrp = hrp,
                                            player = p,
                                            sd = sd,
                                            wd = (hrp.Position - myRoot.Position).Magnitude,
                                            threat = ThreatScore(p, myRoot.Position),
