            rlbl.TextSize = 12
            rlbl.Parent = popup

            local rtrack = Instance.new("Frame")
            rtrack.Size = UDim2.new(1, -60, 0, 6)
            rtrack.Position = UDim2.new(0, 38, 0, 18 + (i - 1) * 42)
            rtrack.BackgroundColor3 = C.TrackOff
            rtrack.BorderSizePixel = 0
            rtrack.Parent = popup
            Instance.new("UICorner", rtrack).CornerRadius = UDim.new(1, 0)

            local rel = cur[i] / 255
            local rfill = Instance.new("Frame")
            rfill.Size = UDim2.new(rel, 0, 1, 0)
            rfill.BackgroundColor3 = C.Accent
            rfill.BorderSizePixel = 0
            rfill.Parent = rtrack
            Instance.new("UICorner", rfill).CornerRadius = UDim.new(1, 0)

            local rbtn = Instance.new("TextButton")
            rbtn.Size = UDim2.new(1, 0, 1, 0)
            rbtn.BackgroundTransparency = 1
            rbtn.Text = ""
            rbtn.Parent = rtrack
            local dragging = false
            local function rset(x)
                local rr = math.clamp((x - rtrack.AbsolutePosition.X) / math.max(rtrack.AbsoluteSize.X, 1), 0, 1)
                rfill.Size = UDim2.new(rr, 0, 1, 0)
                cur[i] = math.floor(rr * 255)
                sync()
            end
            rbtn.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    rset(inp.Position.X)
                end
