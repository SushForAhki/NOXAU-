local _ = (function()
    local PR = _G.NOXAUi.Profiles
    local CFG = _G.NOXAUi.CFG
    local ProfileFile = "NOXAUi_v1_profiles.json"
    local GameKey = tostring(game.PlaceId)
    local function KeyOf(n) if CFG.PerGameProfiles then return GameKey .. "::" .. n end return n end
    local Data = {}

    if HAS_FS and isfile(ProfileFile) then
        pcall(function() Data = HttpSvc:JSONDecode(readfile(ProfileFile)) end)
    end

    local function SaveAll()
        if not HAS_FS then return end
        pcall(function() writefile(ProfileFile, HttpSvc:JSONEncode(Data)) end)
    end

    PR.Save = function(name)
        if not name or name == "" then return end
        local c = {}
        for k, v in pairs(CFG) do
            if k ~= "ChatLog" and k ~= "ActiveProfile" then c[k] = v end
        end
        Data[KeyOf(name)] = c
        SaveAll()
        DBG("profile saved:", name)
    end

    PR.Load = function(name)
        local key = KeyOf(name)
        if not Data[key] then return end
        for k, v in pairs(Data[key]) do
            if k ~= "Version" and CFG[k] ~= nil and type(CFG[k]) == type(v) then CFG[k] = v end
        end
        CFG.ActiveProfile = name
        Save()
        DBG("profile loaded:", name)
    end

    PR.Delete = function(name)
        Data[KeyOf(name)] = nil
        SaveAll()
        DBG("profile deleted:", name)
    end

    PR.List = function()
        local out = {}
        for k in pairs(Data) do
            if CFG.PerGameProfiles then
                if k:find(GameKey .. "::", 1, true) then out[#out + 1] = k:gsub(GameKey .. "::", "") end
            else
                if not k:find("::", 1, true) then out[#out + 1] = k end
            end
        end
        return out
    end

    _G.NOXAUi.ProfileData = Data
end)()
