            end
        else
            data.headDot.Visible = false
        end
    end

    if data.flags then
        if CFG.ESPFlags and doText then
            local list = {}
            local vel = hrp.AssemblyLinearVelocity
            local ratio = hum.Health / math.max(hum.MaxHealth, 1)
            if vel.Y > 12 or vel.Y < -22 then list[#list + 1] = "AIR" end
            if ratio < 0.35 then list[#list + 1] = "LOW" end
            local head = char:FindFirstChild("Head")
            if head and head.Transparency > 0.4 then list[#list + 1] = "INV" end
            if not char:FindFirstChildOfClass("Tool") then list[#list + 1] = "UNARMED" end
            if dist < 120 and myRoot then
                local toMe = (myRoot.Position - hrp.Position)
                if toMe.Magnitude > 0.01 and hrp.CFrame.LookVector:Dot(toMe.Unit) > 0.82 then
                    list[#list + 1] = "LOOKING"
                end
            end
            local txt = table.concat(list, " ")
            if txt ~= "" then
                data.flags.Text = txt
                data.flags.Color = ColFromT(CFG.ESPFlagColor)
                data.flags.Position = Vector2.new(sp.X, y1 - 20)
                data.flags.Transparency = 1 - alpha
                data.flags.Visible = true
            else
