    local function ItemMatch(d)
        local filter = CFG.ESPItemFilterMode or CFG.ESPItemFilter or "hepsi"
        local custom = string.lower(CFG.ESPItemCustom or "")
        if d:IsA("Tool") then
            return (filter == "hepsi" or filter == "silahlar")
        elseif d:IsA("Model") or d:IsA("BasePart") then
            local n = string.lower(d.Name)
            local isGiver = n:find("giver", 1, true) or n:find("gift", 1, true)
                or n:find("veren", 1, true)
            if filter == "hepsi" or filter == "vericiler" then
