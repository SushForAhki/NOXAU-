task.spawn(function()
    local frames = 0
    local lastT = now()
    RunService.RenderStepped:Connect(function() frames = frames + 1 end)
    while gui.Parent do
        task.wait(1)
        local t = now()
        local fps = math.floor(frames / math.max(t - lastT, 0.001))
        frames = 0
        lastT = t
        local ping = 0
        pcall(function() ping = math.floor(LocalPlayer:GetNetworkPing() * 1000) end)
        local keyTxt = ""
        local exp = rawget(_G, "__NOXA_KEY_EXPIRY")
        if type(exp) == "number" and exp > 0 then
            local left = exp - os.time()
            if left > 0 then
                local d = math.floor(left / 86400)
                local h = math.floor((left % 86400) / 3600)
                keyTxt = "  ·  KEY " .. (d > 0 and (d .. "g " .. h .. "sa") or math.max(h, 1) .. "sa")
            else
                keyTxt = "  ·  KEY SURESI DOLDU"
            end
        end
        FooterStats.Text = fps .. " FPS  ·  " .. ping .. " ms" .. keyTxt
    end
end)

