    local function DropShape(sh)
        for _, l in ipairs(sh.lines) do DrawingRemove(l) end
        DrawingRemove(sh.name)
        DrawingRemove(sh.dist)
    end

    local function HideShape(sh)
        for _, l in ipairs(sh.lines) do l.Visible = false end
        sh.name.Visible = false
        sh.dist.Visible = false
    end

    local function GetItemPos(d)
        if d:IsA("BasePart") then return d.Position end
        if d:IsA("PVInstance") then
