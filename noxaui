    local origFns = {}
    local function HookHwidFns()
        for _, nm in ipairs({ "gethwid", "get_hwid" }) do
            if not origFns[nm] then
                for _, env in ipairs(envTables) do
                    local v = env[nm]
                    if type(v) == "function" then
                        origFns[nm] = v
                        break
                    end
                end
            end
            local orig = origFns[nm]
            if orig and type(orig) == "function" and not origFns[nm .. "_w"] then
                local wrapped = function(...)
                    if HWS.Active and CFG.HWIDSpoof and CFG.HWIDSpoofHwidFn then
                        HWS.Count = HWS.Count + 1
                        HWS.LastAt = os.time()
                        return GetSpoofHWID()
                    end
                    return orig(...)
                end
                origFns[nm .. "_w"] = wrapped
                for _, env in ipairs(envTables) do
                    if type(env[nm]) == "function" then
                        pcall(function() env[nm] = wrapped end)
                    end
                end
            end
        end
    end

    local function SetupClientIdHook()
        if HWS.HookInstalled then return end
        if type(hookmetamethod) == "function" and type(newcclosure) == "function" then
            local ok, err = pcall(function()
                local oldNC
                oldNC = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
                    if ShouldSpoof(self) and getnamecallmethod() == "GetClientId" then
                        HWS.Count = HWS.Count + 1
                        HWS.LastAt = os.time()
                        return GetSpoofHWID()
                    end
                    return oldNC(self, ...)
                end))
                local oldIX
                oldIX = hookmetamethod(game, "__index", newcclosure(function(self, k)
                    local v = oldIX(self, k)
                    if type(k) == "string" and k == "GetClientId" and type(v) == "function" and ShouldSpoof(self) then
                        return function(...)
                            HWS.Count = HWS.Count + 1
                            HWS.LastAt = os.time()
                            return GetSpoofHWID()
                        end
                    end
                    return v
                end))
                HWS.HookInstalled = true
                HWS.Hook = "hookmetamethod (__namecall + __index)"
            end)
            if not ok then
                HWS.Hook = "kurulum hatasi: " .. tostring(err):sub(1, 60)
            end
        elseif type(getrawmetatable) == "function" and type(setreadonly) == "function" then
            local ok, err = pcall(function()
                local mt = getrawmetatable(game)
                if not mt or not mt.__namecall then error("metatable yok") end
                HWS.mt = mt
                HWS.oldNC = mt.__namecall
                HWS.oldIX = mt.__index
                setreadonly(mt, false)
                local oldNC = HWS.oldNC
                local oldIX = HWS.oldIX
                mt.__namecall = function(self, ...)
                    local m = nil
                    if type(getnamecallmethod) == "function" then m = getnamecallmethod() end
                    if m == "GetClientId" and ShouldSpoof(self) then
                        HWS.Count = HWS.Count + 1
                        HWS.LastAt = os.time()
                        return GetSpoofHWID()
                    end
                    return oldNC(self, ...)
                end
                mt.__index = function(self, k)
                    local v = oldIX(self, k)
                    if type(k) == "string" and k == "GetClientId" and type(v) == "function" and ShouldSpoof(self) then
                        return function(...)
                            HWS.Count = HWS.Count + 1
                            HWS.LastAt = os.time()
                            return GetSpoofHWID()
                        end
                    end
                    return v
                end
                HWS.HookInstalled = true
                HWS.Hook = "raw metatable (__namecall + __index)"
            end)
            if not ok then
                HWS.Hook = "kurulum hatasi: " .. tostring(err):sub(1, 60)
            end
        else
            HWS.Hook = "yok — executor hookmetamethod sunmuyor"
        end
    end

