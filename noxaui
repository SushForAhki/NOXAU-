        if CFG.AimSticky and StickyTarget and now() < StickyUntil then
            for _, c in ipairs(candidates) do
                if c.player == StickyTarget then StickyUntil = now() + CFG.AimStickyTime return c end
            end
        end
        if #candidates == 0 then return nil end
        if CFG.AimSwitchDelay > 0 and Locked and (now() - LastLock) * 1000 < CFG.AimSwitchDelay then
            for _, c in ipairs(candidates) do
                if c.player == Locked.player then return c end
            end
        end
        if CFG.AimPriority == "Nişangah" then
            table.sort(candidates, function(a, b) return a.sd < b.sd end)
