    local function ReseedItems()
        pcall(function()
            for _, d in ipairs(Workspace:GetDescendants()) do
                if ItemMatch(d) and GetItemPos(d) then ItemRegistry[d] = true end
            end
        end)
        lastItemFilter = ItemFilterKey()
    end

    local function SyncRegistry()
        -- NPC senkronu: registry uzerinden (harita taramasi yok, cok ucuz)
        local npcWanted = {}
        if CFG.ESPNPC then
            local npcCount = 0
            for m, entry in pairs(NPCRegistry) do
                if npcCount >= 30 then break end
                if m.Parent and entry and entry.root and entry.root.Parent
                    and entry.hum and entry.hum.Parent and entry.hum.Health > 0
                    and not Players:GetPlayerFromCharacter(m) then
                    npcWanted[m] = true
                    npcCount = npcCount + 1
                end
            end
        end
        for m in pairs(npcShapes) do
            if not npcWanted[m] then
                DropShape(npcShapes[m])
                npcShapes[m] = nil
            end
        end
        for m in pairs(npcWanted) do
            if not npcShapes[m] then npcShapes[m] = MakeShape() end
        end

        -- esya: ozellik acilinca / filtre degisince tek seferlik kayit,
        -- sonrasinda registry'den senkron (periyodik tarama yok)
        local on = CFG.ESPItem
        if on and not itemWasOn then
            itemWasOn = true
            ReseedItems()
        elseif not on and itemWasOn then
            itemWasOn = false
            for k in pairs(ItemRegistry) do ItemRegistry[k] = nil end
        end
        local fkey = ItemFilterKey()
        if on and fkey ~= lastItemFilter then
            for k in pairs(ItemRegistry) do ItemRegistry[k] = nil end
            ReseedItems()
        end
        local itemWanted = {}
        if on then
            local itemCount = 0
            for it in pairs(ItemRegistry) do
                if itemCount >= 25 then break end
                if it.Parent and ItemMatch(it) and GetItemPos(it) then
                    itemWanted[it] = true
                    itemCount = itemCount + 1
                end
            end
        end
        for it in pairs(itemShapes) do
            if not itemWanted[it] then
                DropShape(itemShapes[it])
                itemShapes[it] = nil
            end
        end
        for it in pairs(itemWanted) do
            if not itemShapes[it] then itemShapes[it] = MakeShape() end
        end
    end

    local function RenderAll()
        local myRoot = GetRoot(LocalPlayer.Character)
        if not CFG.ESPNPC then
            for _, sh in pairs(npcShapes) do HideShape(sh) end
        else
            local col = ColFromT(CFG.ESPNPCColor)
            for m, sh in pairs(npcShapes) do
                local entry = NPCRegistry[m]
                local root = entry and entry.root
                if root and root.Parent and m.Parent
                    and entry.hum and entry.hum.Parent and entry.hum.Health > 0
                    and not Players:GetPlayerFromCharacter(m) then
