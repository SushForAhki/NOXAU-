local function Slider(parent, name, mn, mx, default, cb)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, 50)
    f.BackgroundColor3 = C.Card
    f.BorderSizePixel = 0
    f.Parent = parent
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 8)
    local fs = Instance.new("UIStroke")
    fs.Color = C.Border
    fs.Thickness = 1
    fs.Transparency = 0.4
    fs.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    fs.Parent = f

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -24, 0, 18)
    lbl.Position = UDim2.new(0, 14, 0, 8)
    lbl.BackgroundTransparency = 1
    lbl.Text = name .. "   " .. tostring(default)
    lbl.TextColor3 = C.Text
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Font = F.Sem
    lbl.TextSize = 12
    lbl.Parent = f

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -28, 0, 6)
    track.Position = UDim2.new(0, 14, 0, 36)
    track.BackgroundColor3 = C.TrackOff
    track.BorderSizePixel = 0
    track.Parent = f
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local rel0 = (mx == mn) and 0 or math.clamp((default - mn) / (mx - mn), 0, 1)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(rel0, 0, 1, 0)
    fill.BackgroundColor3 = C.Accent
    fill.BorderSizePixel = 0
    fill.Parent = track
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local dot = Instance.new("Frame")
    dot.Size = UDim2.new(0, 12, 0, 12)
    dot.AnchorPoint = Vector2.new(0.5, 0.5)
    dot.Position = UDim2.new(rel0, 0, 0.5, 0)
    dot.BackgroundColor3 = C.Accent
    dot.BorderSizePixel = 0
    dot.Parent = track
    Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

    local ref = { track = track, mn = mn, mx = mx, fill = fill, dot = dot, lbl = lbl, name = name, cb = cb }

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.Parent = f
    btn.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            activeSlider = ref
            local rel = math.clamp((i.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
            local v = math.floor(mn + (mx - mn) * rel)
            fill.Size = UDim2.new(rel, 0, 1, 0)
            dot.Position = UDim2.new(rel, 0, 0.5, 0)
            lbl.Text = name .. "   " .. tostring(v)
            DBG("slider:", name, v)
            if cb then pcall(cb, v) end
        end
    end)

    TrackSearch(f, name)
    AttachTooltip(f, name)
    return ref
end
UIS.InputChanged:Connect(function(i)
    if activeSlider and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
        local tr = activeSlider.track
        if tr and tr.Parent then
            local rel = math.clamp((i.Position.X - tr.AbsolutePosition.X) / math.max(tr.AbsoluteSize.X, 1), 0, 1)
            local v = math.floor(activeSlider.mn + (activeSlider.mx - activeSlider.mn) * rel)
            activeSlider.fill.Size = UDim2.new(rel, 0, 1, 0)
            activeSlider.dot.Position = UDim2.new(rel, 0, 0.5, 0)
            activeSlider.lbl.Text = activeSlider.name .. "   " .. tostring(v)
            if activeSlider.cb then pcall(activeSlider.cb, v) end
        end
    end
end)
UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        activeSlider = nil
    end
end)
