local function ActivateTab(name, noAnim)
    local t = Tabs[name]
    if not t then return end
    for _, other in pairs(Tabs) do
        other.page.Visible = false
        other.btn.BackgroundColor3 = C.Surface
        other.lbl.TextColor3 = C.Dim
        other.acc.BackgroundTransparency = 1
    end
    t.page.Visible = true
    t.btn.BackgroundColor3 = C.Card
    t.lbl.TextColor3 = C.Text
    t.acc.BackgroundTransparency = 0
    CFG.ActiveTab = name
    t.page.Position = UDim2.new(0, 15, 0, 0)
    TS:Create(t.page, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = UDim2.new(0, 0, 0, 0) }):Play()
    if CFG.TabAnim and not noAnim then
        local i = 0
        for _, child in ipairs(t.page:GetChildren()) do
            if child:IsA("GuiObject") then
                i = i + 1
                local scale = child:FindFirstChildOfClass("UIScale")
                if not scale then
                    scale = Instance.new("UIScale")
                    scale.Parent = child
                end
                scale.Scale = 0.97
                task.delay(math.min(i * 0.012, 0.4), function()
                    if scale.Parent then
                        TS:Create(scale, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1 }):Play()
                    end
                end)
            end
        end
    end
    DBG("tab switch:", name)
end

