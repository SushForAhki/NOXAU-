    local function GenFakeHWID()
        local function part(len)
            local s = ""
            for _ = 1, len do
                s = s .. string.format("%x", math.random(0, 15))
            end
            return s
        end
        return part(8) .. "-" .. part(4) .. "-4" .. part(3) .. "-a" .. part(3) .. "-" .. part(12)
    end

    local function GetSpoofHWID()
        if CFG.HWIDSpoofMode == "Her Açılışta Rastgele" then
            if not HWS.sessionFake then HWS.sessionFake = GenFakeHWID() end
            return HWS.sessionFake
        end
        if type(CFG.HWIDSpoofValue) ~= "string" or CFG.HWIDSpoofValue == "" then
            CFG.HWIDSpoofValue = GenFakeHWID()
