-- GUVENLI DOSYA DEPOLAMA
-- Bazi executorlarda alt klasore yazma sessizce basarisiz oluyor
-- (oturum / kullanilan key kaydedilmiyordu -> surekli yeniden soruyor,
--  key sinirsiz girilebiliyordu). Yonum: once SysCache_Data/ denenir,
--  olmazsa workspace koku. Her yazma yaz-oku-dogrula ile teyit edilir,
--  sonuc konsola yazilir.
-- ============================================================
local function FsExists(path)
    if type(isfile) == "function" then
        local ok, r = pcall(isfile, path)
        if ok and r then return true end
    end
    if type(readfile) == "function" then
        local ok = pcall(readfile, path)
        if ok then return true end
    end
    return false
end

local STORE_DIRS = { "SysCache_Data", "" }
local storeReady = {}

local function StorePath(dir, name)
    if dir == nil or dir == "" then return name end
    return dir .. "/" .. name
end

local function StoreEnsureDir(dir)
    if dir == "" then return true end
    if type(makefolder) ~= "function" then return false end
    if type(isfolder) == "function" then
        local ok, ex = pcall(isfolder, dir)
        if ok and ex then return true end
    end
    pcall(makefolder, dir)
    if type(isfolder) == "function" then
        local ok, ex = pcall(isfolder, dir)
        return ok and ex == true
    end
    return true
end

local function StoreWrite(name, data)
    if type(writefile) ~= "function" then
        warn("[NOXA] writefile yok — " .. name .. " KAYDEDILEMEDI!")
        return false
    end
    local order = {}
    if storeReady[name] then table.insert(order, storeReady[name]) end
    for _, d in ipairs(STORE_DIRS) do
        local dup = false
        for _, o in ipairs(order) do if o == d then dup = true end end
        if not dup then table.insert(order, d) end
    end
    local tried = {}
    for _, d in ipairs(order) do
        local path = StorePath(d, name)
        StoreEnsureDir(d)
        local ok = pcall(writefile, path, data)
        if ok then
            local ok2, back = pcall(readfile, path)
            if ok2 and back == data then
                storeReady[name] = d
                return true, path
            end
        end
        table.insert(tried, path)
    end
    warn("[NOXA] YAZMA BASARISIZ: " .. name .. " | denenen: " .. table.concat(tried, ", "))
    return false
end

local function StoreRead(name)
    local order = {}
    if storeReady[name] then table.insert(order, storeReady[name]) end
    for _, d in ipairs(STORE_DIRS) do
        local dup = false
        for _, o in ipairs(order) do if o == d then dup = true end end
        if not dup then table.insert(order, d) end
    end
    for _, d in ipairs(order) do
        local path = StorePath(d, name)
        if FsExists(path) then
            local ok, data = pcall(readfile, path)
            if ok and type(data) == "string" and data ~= "" then
                storeReady[name] = d
                return data
            end
        end
    end
    return nil
end

local function StoreDelete(name)
    if type(delfile) ~= "function" then return end
    local dirs = {}
    if storeReady[name] then table.insert(dirs, storeReady[name]) end
    for _, d in ipairs(STORE_DIRS) do
        local dup = false
        for _, o in ipairs(dirs) do if o == d then dup = true end end
        if not dup then table.insert(dirs, d) end
    end
    for _, d in ipairs(dirs) do
        pcall(delfile, StorePath(d, name))
    end
end

