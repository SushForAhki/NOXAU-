                local d = (target.aimPos - Camera.CFrame.Position).Magnitude
                local mn = math.max(CFG.AimDistanceMin, 1)
                local mx = math.max(CFG.AimDistanceMax, mn + 1)
                local rel = math.clamp((d - mn) / (mx - mn), 0, 1)
                t = t * (0.5 + rel * 0.5)
            end
            if CFG.AimCurve == "Üstel" then
                t = t * t
            elseif CFG.AimCurve == "Sigmoid" then
                t = t * (3 - 2 * t)
            end
            Camera.CFrame = Camera.CFrame:Lerp(goal, math.clamp(t, 0.01, 1))
        elseif method == "Fare Hareketi" then
            local sp = Camera:WorldToViewportPoint(target.aimPos)
            local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            local delta = Vector2.new(sp.X, sp.Y) - center
            if delta.Magnitude > CFG.AimDeadzone then
                pcall(function()
                    mousemoverel(delta.X * CFG.AimSmooth, delta.Y * CFG.AimSmooth)
                end)
            end
        elseif method == "Sessiz" then
            local char = LocalPlayer.Character
            local tool = char and char:FindFirstChildOfClass("Tool")
            if tool then
                local old = Camera.CFrame
                pcall(function()
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.aimPos)
                    tool:Activate()
                    if CFG.AimSilentMode ~= "Legit" then Camera.CFrame = old end
                end)
                if CFG.AimSilentMode == "Legit" then
                    task.delay(0.1, function()
                        pcall(function() Camera.CFrame = old end)
                    end)
                end
            end
        elseif method == "Raycast" then
            local sp = Camera:WorldToViewportPoint(target.aimPos)
            local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            local delta = Vector2.new(sp.X, sp.Y) - center
            if delta.Magnitude > CFG.AimDeadzone then
                pcall(function()
                    mousemoverel(delta.X * 0.5, delta.Y * 0.5)
                end)
            end
        end
    end

