            Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)
            local dot = Instance.new("Frame")
            dot.Size = UDim2.fromOffset(8, 8)
            dot.Position = UDim2.new(0, 10, 0.5, -4)
            local inSrv = Players:FindFirstChild(n) ~= nil
            dot.BackgroundColor3 = inSrv and C.Success or C.Border
            dot.BorderSizePixel = 0
            dot.Parent = row
            Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
            local nameL = Instance.new("TextLabel")
            nameL.Size = UDim2.new(1, -110, 1, 0)
            nameL.Position = UDim2.new(0, 26, 0, 0)
            nameL.BackgroundTransparency = 1
            nameL.Text = n .. (inSrv and "  (sunucuda)" or "")
            nameL.TextColor3 = inSrv and C.Text or C.Dim
            nameL.Font = F.Sem
            nameL.TextSize = 12
            nameL.TextXAlignment = Enum.TextXAlignment.Left
            nameL.TextTruncate = Enum.TextTruncate.AtEnd
            nameL.Parent = row
            local rm = Instance.new("TextButton")
            rm.Size = UDim2.new(0, 60, 0, 22)
            rm.Position = UDim2.new(1, -70, 0.5, -11)
            rm.BackgroundColor3 = C.Card
            rm.BorderSizePixel = 0
            rm.Text = "sil"
            rm.TextColor3 = C.Danger
            rm.Font = F.Bold
            rm.TextSize = 11
            rm.Parent = row
            Instance.new("UICorner", rm).CornerRadius = UDim.new(0, 8)
            rm.MouseButton1Click:Connect(function()
                for j = #CFG.WatchList, 1, -1 do
                    if CFG.WatchList[j] == n then table.remove(CFG.WatchList, j) end
                end
                Save()
                RenderWatch()
            end)
        end
    end
    local function CheckWatch()
        local anyChange = false
        for _, n in ipairs(CFG.WatchList) do
            local inSrv = Players:FindFirstChild(n) ~= nil
            local was = watchState[n]
            if was ~= nil and was ~= inSrv then
                anyChange = true
                _G.NOXAUi.Toast("Takip Listesi",
                    n .. (inSrv and " sunucuya GİRDİ" or " sunucudan ÇIKTI"), 6)
            end
            watchState[n] = inSrv
        end
        if anyChange then RenderWatch() end
    end
